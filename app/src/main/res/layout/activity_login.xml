<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F0"
    android:fitsSystemWindows="false">

    <!-- ══ BARRA SUPERIOR ROJA ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#db2d2c"
        android:paddingBottom="16dp">

        <!-- Spacer para status bar (Manejado por LoginActivity.java) -->
        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_logo"
                    android:contentDescription="Logo Mancuria"/>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mancuria"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acceso de Trabajadores"
                    android:textSize="12sp"
                    android:textColor="#FFCCCC"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ══ CONTENIDO SCROLLEABLE ══ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Contenedor del Formulario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INICIAR SESIÓN"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#9E9E9E"
                            android:letterSpacing="0.10"
                            android:layout_marginBottom="18dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilUser"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Nombre de Usuario"
                            app:boxStrokeColor="#db2d2c"
                            app:hintTextColor="#db2d2c"
                            app:startIconDrawable="@drawable/ic_person"
                            app:startIconTint="#BDBDBD"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp"
                            android:layout_marginBottom="14dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etUserLogin"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:textColor="#212121"
                                android:textSize="15sp"
                                android:inputType="text"
                                android:imeOptions="actionNext"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPassword"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Contraseña"
                            app:boxStrokeColor="#db2d2c"
                            app:hintTextColor="#db2d2c"
                            app:startIconDrawable="@drawable/ic_lock"
                            app:startIconTint="#BDBDBD"
                            app:endIconMode="password_toggle"
                            app:endIconTint="#9E9E9E"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp"
                            android:layout_marginBottom="22dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPasswordLogin"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:textColor="#212121"
                                android:textSize="15sp"
                                android:inputType="textPassword"
                                android:imeOptions="actionDone"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLogin"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Ingresar"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            app:cornerRadius="10dp"
                            app:backgroundTint="#db2d2c"
                            app:icon="@android:drawable/ic_media_play"
                            app:iconTint="#FFFFFF"
                            app:iconGravity="end"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mancuria V4.0"
                    android:textSize="12sp"
                    android:textColor="#BDBDBD"/>
            </LinearLayout>

            <!-- ══ BARRA INFERIOR ROJA — Dentro del Scroll para evitar el error visual ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#db2d2c"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="© 2025 Mancuria — Todos los derechos reservados"
                    android:textSize="11sp"
                    android:textColor="#FFAAAA"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Spacer dinámico para evitar que la barra de navegación tape el contenido -->
    <View
        android:id="@+id/navigationBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>

</LinearLayout>
