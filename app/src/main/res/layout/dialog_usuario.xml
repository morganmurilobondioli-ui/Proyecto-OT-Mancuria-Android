<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Datos del Trabajador"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/rojo_mancuria"
        android:layout_marginBottom="20dp"/>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/InputRojo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre Completo"
        app:boxBackgroundColor="#FFFFFF"
        android:layout_marginBottom="14dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNombreUsuario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textColor="#212121"
            android:inputType="textCapWords"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/InputRojo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Correo de Firebase Auth"
        app:boxBackgroundColor="#FFFFFF"
        android:layout_marginBottom="14dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUserLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textColor="#212121"
            android:inputType="textEmailAddress"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/InputRojo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="UID de Firebase Auth"
        app:boxBackgroundColor="#FFFFFF"
        android:layout_marginBottom="18dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPasswordUsuario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textColor="#212121"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rol del Trabajador"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#616161"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rgRolUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">
        <RadioButton
            android:id="@+id/rbMecanico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mecánico"
            android:textColor="#212121"
            android:checked="true"/>
        <RadioButton
            android:id="@+id/rbAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Administrador"
            android:textColor="#212121"
            android:layout_marginStart="24dp"/>
    </RadioGroup>

</LinearLayout>
