<resources>
    <style name="Base.Theme.Mancuria" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/rojo_mancuria</item>
        <item name="colorPrimaryDark">@color/rojo_oscuro</item>
        <item name="colorAccent">@color/rojo_mancuria</item>

        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/rojo_mancuria</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Forzar colores de texto para evitar que se vean en blanco -->
        <item name="android:textColorPrimary">#212121</item>
        <item name="android:editTextColor">#000000</item>
        <item name="android:textColorHint">#757575</item>
    </style>

    <style name="Theme.Mancuria" parent="Base.Theme.Mancuria" />

    <!-- Estilo para inputs con borde rojo y texto siempre visible -->
    <style name="InputRojo" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/rojo_mancuria</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2.5dp</item>
        <item name="hintTextColor">@color/rojo_mancuria</item>
        <item name="android:textColorHint">#757575</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>
